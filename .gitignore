# ─────────────────────────────────────────────────────────────────────────────
#  Golden Axe III (RUS) — ROM-hacking toolkit
#
#  The game ROM is copyrighted by SEGA and is NEVER committed. It lives in
#  baserom/ (ignored) and everything derived from it lands in build/ (ignored).
#  assets/ holds the editable, human-readable form of the image; verbatim byte
#  copies of code and unidentified regions are extracted for browsing only.
# ─────────────────────────────────────────────────────────────────────────────

# ROM images, any extension, anywhere
*.bin
*.gen
*.smd
*.32x
*.md.bin
baserom/*
!baserom/README.md

# Everything derived: built ROM and IPS, emulator binary and objects,
# screenshots, memory dumps, previews, generated WAVs
build/

# Extracted but not committed (see STYLE.md "what is committed")
assets/code/*.m68k
assets/raw/
assets/gfx/nemesis/*.4bpp

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Emulator scratch
*.gs?
*.state
*.srm
